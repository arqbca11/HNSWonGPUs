# The GPU worker image (Phase 5 decisions 1, 10): the CPU image is unchanged
# (worker/Dockerfile); this one starts from NVIDIA's RAPIDS base, which ships
# CUDA 12 and the cuVS library the CAGRA build path imports, and installs the
# same builder and worker packages on top. The worker runs the builder CLI as
# a child process exactly as on the CPU image, with BUILDER=cagra selecting
# the GPU path (deploy/k8s-gcp-gpu/config-gpu.yaml). hnswlib is compiled
# here too: it is what loads the converted file, the proof of decision 10.
#
#   docker buildx build --platform linux/amd64 -f worker/Dockerfile.gpu \
#     -t us-west1-docker.pkg.dev/project-3456ed25-5d5d-4b0d-aa5/kgpu/kgpu-worker-gpu:p5 --push .
#
# The image is several GB (CUDA); it is only ever pulled by a GPU node.
# Context: the repo root (both packages are copied in).
FROM rapidsai/base:26.10-cuda12-py3.12

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential tini && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY builder /app/builder
COPY worker /app/worker
# the RAPIDS image's conda python is the one with cuvs; install into it
# the RAPIDS image marks its conda Python "externally managed" (PEP 668): a plain
# pip refuses; the flag is the sanctioned way to install into it in an image
RUN pip install --no-cache-dir --break-system-packages /app/builder /app/worker

# GKE mounts the node's driver at /usr/local/nvidia; the runtime must find libcuda there
ENV PYTHONUNBUFFERED=1 BUILDER=cagra BUILD_THREADS=6 LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "kgpu_worker"]
